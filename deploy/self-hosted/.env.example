# Self-hosted VoiceOrch orchestration layer — environment template.
# Copy to deploy/self-hosted/.env and fill in your own values.
# Everything below is YOUR infrastructure — nothing here talks to SnapServe's
# servers or bills against SnapServe's accounts.

# --- Required ---

# Any strong random string (used to sign session JWTs and encrypt provider
# API keys at rest). Generate with: openssl rand -hex 32
SESSION_SECRET=

# Postgres password for the bundled db service (docker-compose only).
POSTGRES_PASSWORD=

# The public domain this instance will be reached at, e.g. voice.yourcompany.com
# Used to derive OAuth redirect URIs and other absolute links. No scheme, no path.
APP_DOMAIN=

# --- Optional: Google login + Google Calendar scheduling ---
# You must create your own Google Cloud OAuth app (console.cloud.google.com)
# with an authorized redirect URI of:
#   https://<APP_DOMAIN>/api/auth/google/callback
# Leave both blank to disable Google login and calendar sync entirely.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: booking email notifications ---
# Leave blank to skip sending scheduling confirmation emails.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Optional: Redis-backed caching ---
# Leave blank to run without Redis — the app falls back to DB-only paths.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Bring your own provider keys ---
# There is nothing to configure here. Every ASR/LLM/TTS/telephony provider key
# (Deepgram, ElevenLabs, OpenAI, Twilio, etc.) is added per-agent inside the
# app's Providers page after you log in — this deployment ships with NO
# managed/platform keys and cannot bill per-minute usage, so it is BYOP-only.
