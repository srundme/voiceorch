modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "gce"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/gender-service: Voice Analysis"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "artifacts/mockup-sandbox: Component Preview Server"

[[workflows.workflow]]
name = "artifacts/gender-service: Voice Analysis"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/gender-service && PORT=5000 python3 main.py"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "artifacts/mockup-sandbox: Component Preview Server"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"
isCanvasWorkflow = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=8081 BASE_PATH=/__mockup pnpm --filter @workspace/mockup-sandbox run dev"
waitForPort = 8081

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 300000

[nix]
channel = "stable-25_05"
packages = ["ffmpeg-full", "libsndfile"]

[userenv]

[userenv.shared]
WEBHOOK_BASE_URL = "https://app.snapserve.ai"
GENDER_SERVICE_URL = "https://workspacegender-service-production.up.railway.app"

[userenv.production]
APP_BASE_URL = "https://app.snapserve.ai"
GOOGLE_LOGIN_REDIRECT_URI = "https://app.snapserve.ai/api/auth/google/callback"
GOOGLE_REDIRECT_URI = "https://app.snapserve.ai/api/scheduling/google/callback"

[objectStorage]
defaultBucketID = "replit-objstore-91796087-b1dd-4bb5-9024-614e68bbc16c"

[[ports]]
localPort = 8083
externalPort = 3002

[[ports]]
localPort = 8084
externalPort = 4200

[[ports]]
localPort = 8085
externalPort = 8008

[[ports]]
localPort = 8086
externalPort = 8099

[[ports]]
localPort = 18150
externalPort = 3003

[[ports]]
localPort = 18522
externalPort = 8000

[[ports]]
localPort = 20831
externalPort = 6000

[[ports]]
localPort = 25045
externalPort = 6800

[[ports]]
localPort = 25820
externalPort = 5173

[[ports]]
localPort = 25821
externalPort = 9000
