{
  "name": "@snapserve/mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for SnapServe (app.snapserve.ai) — agents, campaigns, journeys, WhatsApp, Sheets, and more",
  "license": "MIT",
  "type": "module",
  "bin": {
    "snapserve-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "catalog:",
    "typescript": "~5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
