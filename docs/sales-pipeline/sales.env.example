# SnapServe Sales Pipeline — environment variables used by api-server
# Placeholders only. Never commit real values. Set these in Railway Variables
# (or your secret manager) for the api-server service.

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Platform Postgres. Sales tables (sales_*) live here; migrations
# 0127_sales_pipeline + 0128_sales_pipeline_2 apply automatically at boot.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# "production" makes the ss_sales session cookie Secure (HTTPS only).
# Already set by the Dockerfiles.
NODE_ENV=production

# Serves the admin SPA (including /admin-ui/sales) from api-server.
# Already set by the Dockerfiles.
ADMIN_DIST_PATH=artifacts/admin/dist/public

# -----------------------------------------------------------------------------
# Bootstrap (first founder invite only)
# -----------------------------------------------------------------------------

# Sent as X-Admin-Token to POST /api/admin/sales/bootstrap (or used by the
# /admin-ui/sales-setup page). Only works while no active founder exists.
# SUPER_ADMIN_TOKEN is also accepted if configured.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=replace-with-long-random-admin-token

# -----------------------------------------------------------------------------
# Optional — inbound lead webhook
# -----------------------------------------------------------------------------

# HMAC-SHA256 secret for POST /api/sales/webhooks/leads.
# Senders put "sha256=<hex hmac of raw body>" in X-SnapServe-Signature.
# If unset, the webhook returns 503; the rest of the sales app still works.
# Rotate if leaked (single secret: old signatures fail immediately).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SALES_WEBHOOK_SECRET=replace-with-long-random-webhook-secret

# -----------------------------------------------------------------------------
# Tests only (never point at production)
# -----------------------------------------------------------------------------

# Run sales DB tests against a real Postgres instead of the default in-process
# PGlite. Tests create and drop a throwaway schema sales_test_<pid>_<ts>.
# SALES_TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/sales_test
