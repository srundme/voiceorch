{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile",
    "watchPatterns": [
      "/artifacts/api-server/**",
      "/artifacts/dashboard/**",
      "/artifacts/admin/**",
      "/lib/**",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/Dockerfile"
    ]
  },
  "deploy": {
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
