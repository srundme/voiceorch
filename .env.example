
# VoiceOrch — Railway Environment Variables
# Copy this to .env and fill in the real values
# Or add these as Railway Variables in the Railway dashboard

# =============================================================================
# REQUIRED — Server won't start without these
# =============================================================================

# Database connection (Railway PostgreSQL service)
DATABASE_URL=postgresql://postgres:password@host:port/railway

# 32+ byte random secret for signing sessions & encrypting provider keys
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-64-char-hex-secret-here

# Node.js environment
NODE_ENV=production

# =============================================================================
# AI / VOICE PROVIDERS (managed keys + user keys)
# =============================================================================

# Sarvam (ASR / STT)
SARVAM_API_KEY=your-sarvam-key

# Cartesia (TTS)
CARTESIA_API_KEY=your-cartesia-key

# Groq (LLM — seeds the managed key in platform_settings)
GROQ_API_KEY=your-groq-key

# ai-coustics Quail Voice Focus — inbound primary-speaker isolation / NC
# Get key: https://developers.ai-coustics.com → SDK Keys
# Railway: add to the api-server service Variables. Agent Noise Cancellation must be ON.
AIC_SDK_LICENSE=
AIC_MODEL_ID=quail-vf-2.2-l-16khz
# Optional: 0..1 (default 0.8 — Voice AI sweet spot; 1.0 = max BVC, may cut quiet speech)
# AIC_ENHANCEMENT_LEVEL=0.8

# WebRTC AEC3 (VoBiz / PSTN). Default on. Browser webcall skips (getUserMedia AEC).
# AEC3_ENABLED=1
# AEC3_STREAM_DELAY_MS=100
# Immediate rollback if adaptive delay oscillates on a carrier:
# AEC3_ADAPTIVE_DELAY=0
# Canary structured logs (default on). Set 0 to silence. Audio stage dumps off by default.
# VOICE_CANARY=1
# VOICE_CANARY_AUDIO=0
# Keep VOICE_CANARY_AUDIO=1 only for short canary windows — dumps may contain personal speech.
# VOICE_CANARY_AUDIO_TTL_MS=60000
# Turn Acceptance Gate (STT → processTurn): shadow (default, log only) | enforce | off
# TURN_ACCEPTANCE_GATE=shadow
# TURN_ACCEPTANCE_GATE=enforce

# =============================================================================
# GOOGLE OAUTH (for login + calendar)
# =============================================================================

# Google Cloud Console → OAuth 2.0 credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Production redirect URIs (override REPLIT_DOMAINS)
GOOGLE_LOGIN_REDIRECT_URI=https://your-dashboard-domain.com/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://your-api-domain.com/api/scheduling/google/callback
# Recall Calendar V2 — self-serve "Connect Google for AI meetings".
# Uses the same verified `calendar` scope as GOOGLE_REDIRECT_URI (booking).
# Must be registered in Google Cloud Console → OAuth client → Authorized redirect URIs.
GOOGLE_MEET_CALENDAR_REDIRECT_URI=https://your-api-domain.com/api/meet-calendar/google/callback

# =============================================================================
# PAYMENTS
# =============================================================================

# Razorpay (wallet / payments)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# =============================================================================
# REDIS (optional — gracefully degrades if absent)
# =============================================================================

# Upstash Redis (free tier at upstash.com)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# =============================================================================
# EMAIL (optional — scheduling notifications)
# =============================================================================

# Brevo (Sendinblue) — email provider
BREVO_API_KEY=your-brevo-key

# Gmail (fallback for scheduling email)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# =============================================================================
# TELEPHONY (optional)
# =============================================================================

# VoBiz
VOBIZ_AUTH_ID=your-vobiz-id
VOBIZ_AUTH_TOKEN=your-vobiz-token

# =============================================================================
# ADMIN (optional)
# =============================================================================

# Admin panel access token
ADMIN_TOKEN=your-admin-token

# =============================================================================
# INTERNAL SERVICES (Railway inter-service networking)
# =============================================================================

# Gender analysis service — bare host URL ONLY (no trailing slash, no path suffix).
# The API server appends /voice-analysis/gender-ml and /voice-analysis/gender-ml-v2 automatically.
# In Railway: use the service's internal hostname, e.g.
#   GENDER_SERVICE_URL=http://gender-service.railway.internal:5000
GENDER_SERVICE_URL=http://localhost:5000

# =============================================================================
# MEETING BOTS (Recall.ai — Google Meet / Zoom / Teams)
# =============================================================================

# Recall API key (dashboard → API Keys). Region-scoped.
RECALL_API_KEY=
# Optional: ap-northeast-1 | us-west-2 | us-east-1 | eu-central-1
RECALL_REGION=us-west-2
# Google login group ID from Recall (signed-in Meet bots show an email on admit)
RECALL_GOOGLE_LOGIN_GROUP_ID=
# Bot Google Workspace email — shown in UI and added to calendar Meet invites
RECALL_BOT_EMAIL=
# Recall diarization for who-is-speaking only (default on when RECALL_API_KEY
# is set). Live AI still uses SnapServe STT for words; Recall supplies speaker
# names. Uses Recall streaming transcript minutes — set to 0 to disable if
# billing spikes. Low-latency streaming requires language en (speaker IDs still
# work; utterance text is not fed to the live LLM).
# RECALL_DIARIZED_TRANSCRIPT=1
# RECALL_TRANSCRIPT_LANGUAGE=en
# Calendar V2 Svix webhook signing secret (Recall dashboard → Webhooks).
# When set, POST /api/meet-calendar/recall-webhooks verifies svix-signature.
# RECALL_CALENDAR_WEBHOOK_SECRET=whsec_...

# =============================================================================
# FRONTEND SERVICES (dashboard, landing, admin)
# =============================================================================

# These are set by Railway automatically — no need to add manually
# PORT=Railway-injected
# BASE_PATH=Railway-injected (for dashboard, landing, admin)
